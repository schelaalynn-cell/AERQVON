# AERQVON — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Demo Mode ---
# When true, the app runs in demo mode with simulated balances and transactions.
# Set to false only when real wallet infrastructure is fully configured.
VITE_DEMO_MODE=true

# --- AQV Solana launch ---
# Leave blank until the official Pump.fun mint is created and verified.
VITE_AQV_SOLANA_MINT_ADDRESS=

# --- Supabase ---
# Used for user/account data persistence (NOT for seed phrases or private keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- TON/Blockchain RPC ---
# TON API endpoint for blockchain queries (balances, transactions).
# Use a trusted RPC provider or self-hosted node.
VITE_TON_RPC_URL=https://toncenter.com/api/v2

# TON API key (required for toncenter.com production endpoints).
# Obtain from https://tonconsole.com
VITE_TON_API_KEY=

# --- Security Review Gate ---
# CRITICAL: Real fund transfers via TON Connect are blocked until this is set to true.
# Do NOT enable until the full security review is complete and signed off.
VITE_SECURITY_REVIEW_PASSED=false

# --- Market Data API ---
# Optional: live market data provider for token prices.
VITE_MARKET_DATA_API_URL=
